# Upstash Redis for session and token caching (Get from console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Secret key for encrypting cached sessions (32 characters recommended)
SESSION_SECRET_KEY=aether-super-secure-secret-key-change-me

# Optional CORS allowed origins (default: *)
CORS_ORIGINS=*
